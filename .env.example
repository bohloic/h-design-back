# ==============================================================================
# H-Designer Backend - Variables d'Environnement d'Exemple (.env.example)
# Ne contient JAMAIS de vraies clés secrètes. Dupliquez en .env pour configurer.
# ==============================================================================

PORT=205
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de Données (MySQL / TiDB)
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=votre_utilisateur_tidb
DB_PASSWORD=votre_mot_de_passe
DB_NAME=h-design

# Sécurité & JWT
JWT_SECRET=votre_cle_jwt_tres_longue_et_securisee_ici

# 📨 Service Email Mailjet (Recommandé en production)
MAILJET_API_KEY=votre_cle_api_mailjet_32_caracteres
MAILJET_SECRET_KEY=votre_cle_secrete_mailjet_32_caracteres
MAILJET_SENDER_EMAIL=contact@votre-domaine.com
MAILJET_SENDER_NAME="H-Designer"
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=465
SMTP_SECURE=true

# Paiements Paystack
PAYSTACK_SECRET_KEY=votre_cle_secrete_paystack
PAYSTACK_PUBLIC_KEY=votre_cle_publique_paystack

# Intelligence Artificielle & Médias
GEMINI_API_KEY=votre_cle_gemini_api
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Surveillance Sentry (Optionnel)
SENTRY_DSN=https://cle_publique@ingest.sentry.io/123456
